<%- include('partials/header') %>

<section class="section page-intro">
  <div class="container narrow-card">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p>For questions about admissions, departments, or student services, contact the college support team.</p>
  </div>
</section>

<section class="section alt-bg">
  <div class="container contact-grid">
    <div>
      <h2>College information</h2>
      <ul class="check-list">
        <li><strong>Address:</strong> <%= settings.address %></li>
        <li><strong>Phone:</strong> <a href="tel:<%= settings.phone %>"><%= settings.phone %></a></li>
        <li><strong>Email:</strong> <a href="mailto:<%= settings.email %>"><%= settings.email %></a></li>
      </ul>
    </div>
    <div>
      <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form class="stacked-form" action="/contact" method="POST">
        <label>
          Name
          <input type="text" name="name" required />
        </label>
        <label>
          Email
          <input type="email" name="email" required />
        </label>
        <label>
          Phone
          <input type="tel" name="phone" />
        </label>
        <label>
          Subject
          <input type="text" name="subject" />
        </label>
        <label>
          Message
          <textarea name="message" rows="5" required></textarea>
        </label>
        <button class="btn btn-primary" type="submit">Send Message</button>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
