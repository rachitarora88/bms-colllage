<%- include('partials/header') %>

<section class="section page-intro">
  <div class="container narrow-card">
    <p class="eyebrow">Admissions</p>
    <h1>Application form</h1>
    <p>Submit your details for admission consideration. All submitted information is processed securely.</p>
  </div>
</section>

<section class="section alt-bg">
  <div class="container form-wrap">
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form class="stacked-form" action="/apply" method="POST" enctype="multipart/form-data">
      <div class="form-grid">
        <label>
          Full name
          <input type="text" name="applicant_name" value="<%= formData.applicant_name || '' %>" required />
        </label>
        <label>
          Email address
          <input type="email" name="email" value="<%= formData.email || '' %>" required />
        </label>
        <label>
          Phone number
          <input type="tel" name="phone" value="<%= formData.phone || '' %>" />
        </label>
        <label>
          Date of birth
          <input type="date" name="dob" value="<%= formData.dob || '' %>" />
        </label>
        <label class="full-width">
          Address
          <textarea name="address" rows="3"><%= formData.address || '' %></textarea>
        </label>
        <label>
          Previous qualification
          <input type="text" name="previous_qualification" value="<%= formData.previous_qualification || '' %>" />
        </label>
        <label>
          Previous institution
          <input type="text" name="previous_institution" value="<%= formData.previous_institution || '' %>" />
        </label>
        <label>
          Marks / grade information
          <input type="text" name="marks" value="<%= formData.marks || '' %>" />
        </label>
        <label>
          Program applied for
          <input type="text" name="program_applied" value="<%= formData.program_applied || '' %>" required />
        </label>
        <label>
          Academic year
          <input type="text" name="academic_year" value="<%= formData.academic_year || '' %>" />
        </label>
        <label>
          Supporting document
          <input type="file" name="supporting_document" accept=".pdf,.doc,.docx,.jpg,.png" />
        </label>
      </div>

      <label class="checkbox-row">
        <input type="checkbox" name="consent" value="true" required />
        I agree to the privacy notice and consent to the processing of my application details.
      </label>

      <button class="btn btn-primary" type="submit">Submit Application</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
